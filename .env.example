# Web (Next.js)
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333/api
# Use NestJS API instead of client-side mocks
NEXT_PUBLIC_USE_API=true
# Dev role switcher (only when NEXT_PUBLIC_USE_API=false)
NEXT_PUBLIC_ENABLE_ROLE_SWITCH=false

# API (NestJS)
PORT=3333
DATABASE_URL=postgresql://laam:laam@localhost:5432/laam
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
# mock = log only | smtp = Brevo/real mail
EMAIL_MODE=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM="Laam CRM <crm.laam@gmail.com>"

# Seed (local only — do not commit real passwords)
SUPER_ADMIN_EMAIL=crm.laam@gmail.com
SUPER_ADMIN_PASSWORD=

# Object storage (S3-compatible). Local: MinIO via docker compose.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=laam
S3_SECRET_ACCESS_KEY=laamsecret
S3_BUCKET=laam-uploads
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/laam-uploads

# Worker
WORKER_HEARTBEAT_MS=30000
