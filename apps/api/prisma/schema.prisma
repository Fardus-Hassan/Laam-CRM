generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String
  status    String   @default("active") // active | suspended | onboarding
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  passwordHash        String
  inviteTempPassword  String?
  name                String
  systemRole       String
  status           String        @default("active") // active | invited | suspended
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRoleId     String?
  permissionGrants String[]      @default([])
  permissionDenies String[]      @default([])
  lastSeenAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  otpChallenges    OtpChallenge[]
  trustedDevices   TrustedDevice[]

  @@index([organizationId])
}

model OtpChallenge {
  id             String    @id @default(uuid())
  purpose        String
  email          String
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  codeHash       String
  relayCode      String?
  expiresAt      DateTime
  resendAfter    DateTime
  attempts       Int       @default(0)
  consumedAt     DateTime?
  delivery       String    // email | admin_inbox
  createdAt      DateTime  @default(now())

  @@index([email, purpose])
  @@index([organizationId, delivery])
}

model TrustedDevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  label     String?
  trustedAt DateTime @default(now())

  @@unique([userId, deviceId])
}

model Lead {
  id                String   @id @default(cuid())
  organizationId    String?
  leadNumber        String   @unique
  name              String
  phone             String
  email             String?
  source            String
  status            String
  assignedAgentName String?
  area              String?
  estimatedValue    Float?
  campaignName      String?
  notes             String?
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Contact {
  id                String   @id @default(cuid())
  organizationId    String?
  name              String
  phone             String
  email             String?
  companyName       String?
  jobTitle          String?
  source            String
  assignedAgentName String?
  address           String?
  notes             String?
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Company {
  id                String   @id @default(cuid())
  organizationId    String?
  name              String
  industry          String?
  status            String
  phone             String?
  email             String?
  contactCount      Int      @default(0)
  dealValue         Float    @default(0)
  assignedAgentName String?
  city              String?
  address           String?
  website           String?
  notes             String?
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Deal {
  id                String    @id @default(cuid())
  organizationId    String?
  dealNumber        String    @unique
  title             String
  companyName       String
  contactName       String?
  stage             String
  amount            Float
  probability       Int
  expectedCloseDate DateTime?
  assignedAgentName String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Order {
  id                String   @id @default(cuid())
  organizationId    String?
  orderNumber       String   @unique
  status            String
  customerName      String
  customerPhone     String
  source            String
  itemsCount        Int
  amount            Float
  paymentStatus     String
  assignedAgentName String?
  shippingArea      String
  shippingAddress   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
