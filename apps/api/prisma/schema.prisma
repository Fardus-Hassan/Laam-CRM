generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  plan               String
  status             String             @default("active") // active | suspended | onboarding
  phone              String?
  // Tenant brand colors + light/dark logo URLs
  branding           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  users              User[]
  teams              Team[]
  customRoles        CustomRole[]
  permissionPresets  PermissionPreset[]
  notifications      Notification[]
  productBrands      ProductBrand[]
  orgCategories      OrgCategory[]
  products           Product[]
  productVariants    ProductVariant[]
  stockMovements     InventoryStockMovement[]
  catalogActivities  CatalogActivity[]
  inventorySuppliers       InventorySupplier[]
  inventoryPurchases       InventoryPurchase[]
  inventoryPurchaseReturns InventoryPurchaseReturn[]
  mixerRecipes             MixerRecipe[]
  productionBatches        ProductionBatch[]
  warehouses               Warehouse[]
  inventoryLots            InventoryLot[]
  accountingJournalEntries AccountingJournalEntry[]
  unitsOfMeasure           UnitOfMeasure[]
  orders                   Order[]
  orderFormOptions         OrderFormOption[]
  coupons                  Coupon[]
  leads                    Lead[]
  followups                Followup[]
  courierIntegrations      CourierIntegration[]
  courierStatusMaps        CourierStatusMap[]
  smsIntegration           SmsIntegration?
  smsTemplates             SmsTemplate[]
  smsLogs                  SmsLog[]
  orderPayments            OrderPayment[]
  failedOrders             FailedOrder[]
  orgOrderStatuses          OrgOrderStatus[]
  orgOrderQueues           OrgOrderQueue[]
}

/// Per-tenant courier credentials (Pathao, etc.). Secrets stored encrypted.
model CourierIntegration {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider         String // pathao | steadfast | carrybee
  enabled          Boolean      @default(false)
  environment      String       @default("sandbox") // sandbox | live
  storeId          String?
  /// AES-GCM payload: clientId, clientSecret, username, password, baseUrl?
  credentialsEnc   String?
  lastSyncAt       DateTime?
  lastError        String?
  syncIntervalSec  Int          @default(180)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId, enabled])
}

/// Per-tenant SMS gateway (custom HTTP API — Gennet, SSL, etc.). Secrets encrypted.
model SmsIntegration {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider         String       @default("custom")
  enabled          Boolean      @default(false)
  /// AES-GCM JSON: apiUrl, httpMethod, paramsTemplate, headersJson?
  credentialsEnc   String?
  /// When true, status changes may auto-send mapped templates.
  autoSmsOnStatusChange Boolean  @default(false)
  /// Map of order status slug → SMS template slug, e.g. { "confirmed": "confirm" }
  statusSmsMap     Json?
  lastSentAt       DateTime?
  lastError        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, enabled])
}

/// Org SMS message templates (manual send + future status automations).
model SmsTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String
  label          String
  message        String       @db.Text
  enabled        Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, sortOrder])
}

/// Audit log for outbound SMS.
model SmsLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId        String?
  toPhone        String
  message        String       @db.Text
  status         String
  providerRef    String?
  error          String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, orderId])
}

/// Configurable courier → CRM status catalog (filter labels + auto-map).
model CourierStatusMap {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String
  slug           String
  label          String
  crmStatus      String?
  isTerminal     Boolean      @default(false)
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider, slug])
  @@index([organizationId, provider, isActive])
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  inviteTempPassword  String?
  name                String
  systemRole          String
  status              String         @default("active") // active | invited | suspended
  organizationId      String?
  organization        Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRoleId        String?
  customRole          CustomRole?    @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  permissionGrants    String[]       @default([])
  permissionDenies    String[]       @default([])
  teamId              String?
  team                Team?          @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeams            Team[]         @relation("TeamLeader")
  invitedByUserId     String?
  invitedBy           User?          @relation("UserInvites", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitedUsers        User[]         @relation("UserInvites")
  lastSeenAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  otpChallenges       OtpChallenge[]
  trustedDevices      TrustedDevice[]
  notifications       Notification[]

  @@index([organizationId])
  @@index([teamId])
  @@index([customRoleId])
  @@index([invitedByUserId])
}

model CustomRole {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  permissions       String[]     @default([])
  dashboardTemplate String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  users             User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PermissionPreset {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  permissions       String[]     @default([])
  dashboardTemplate String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  leaderUserId   String
  leader         User         @relation("TeamLeader", fields: [leaderUserId], references: [id], onDelete: Restrict)
  members        User[]       @relation("TeamMembers")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([leaderUserId])
}

model OtpChallenge {
  id             String    @id @default(uuid())
  purpose        String
  email          String
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  codeHash       String
  relayCode      String?
  expiresAt      DateTime
  resendAfter    DateTime
  attempts       Int       @default(0)
  consumedAt     DateTime?
  delivery       String    // email | admin_inbox
  createdAt      DateTime  @default(now())

  @@index([email, purpose])
  @@index([organizationId, delivery])
}

model TrustedDevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  label     String?
  trustedAt DateTime @default(now())

  @@unique([userId, deviceId])
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  title          String
  body           String
  href           String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

model Lead {
  id                String    @id @default(cuid())
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadNumber        String
  name              String
  phone             String
  email             String?
  source            String
  status            String
  assignedAgentName String?
  area              String?
  address           String?
  estimatedValue    Float?
  campaignName      String?
  notes             String?
  tags              String[]  @default([])
  productSummary    String?
  itemCount         Int?
  followUpDue       DateTime?
  /// Stores converted order number (UI links to /dashboard/orders/:orderId).
  orderId           String?
  convertedAt       DateTime?
  lastActivityAt    DateTime?
  lineItems         Json      @default("[]")
  activities        Json      @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([organizationId, leadNumber])
  @@index([organizationId, status])
  @@index([organizationId, phone])
}

model Contact {
  id                String   @id @default(cuid())
  organizationId    String?
  name              String
  phone             String
  email             String?
  companyName       String?
  jobTitle          String?
  source            String
  assignedAgentName String?
  address           String?
  notes             String?
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Company {
  id                String   @id @default(cuid())
  organizationId    String?
  name              String
  industry          String?
  status            String
  phone             String?
  email             String?
  contactCount      Int      @default(0)
  dealValue         Float    @default(0)
  assignedAgentName String?
  city              String?
  address           String?
  website           String?
  notes             String?
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Deal {
  id                String    @id @default(cuid())
  organizationId    String?
  dealNumber        String    @unique
  title             String
  companyName       String
  contactName       String?
  stage             String
  amount            Float
  probability       Int
  expectedCloseDate DateTime?
  assignedAgentName String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Order {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderNumber        String
  status             String
  customerName       String
  customerPhone      String
  customerEmail      String?
  altMobile          String?
  customerNote       String?
  customerTag        String?
  orderTag           String?
  source             String
  itemsCount         Int
  subtotal           Float    @default(0)
  discount           Float    @default(0)
  deliveryCharge     Float    @default(0)
  amount             Float
  paidAmount         Float    @default(0)
  paymentStatus      String
  paymentMethod      String?
  assignedAgentName  String?
  shippingArea       String
  shippingAddress    String?
  district           String?
  pathaoCity         String?
  pathaoZone         String?
  pathaoArea         String?
  pathaoCityId       Int?
  pathaoZoneId       Int?
  pathaoAreaId       Int?
  carrybeeCity       String?
  carrybeeZone       String?
  carrybeeArea       String?
  carrybeeCityId     Int?
  carrybeeZoneId     Int?
  carrybeeAreaId     Int?
  notes              String?
  courierNote        String?
  packingNote        String?
  referenceNo        String?
  orderDate          DateTime @default(now())
  skipFollowup       Boolean  @default(false)
  couponCode         String?
  courierChargedToMe Float    @default(0)
  courierProvider    String?
  courierConsignmentId String?
  courierTrackingCode  String?
  courierCollectAmount Float?
  courierBookedAt    DateTime?
  courierStatus      String?
  courierStatusSlug  String?
  courierStatusSyncedAt DateTime?
  leadId             String?
  utmSource          String?
  utmId              String?
  utmContent         String?
  utmCampaign        String?
  attachmentNames    String[] @default([])
  attachmentUrls     String[] @default([])
  stockDeductedAt    DateTime?
  deletedAt          DateTime?
  createdByUserId    String?
  createdByName      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lineItems          OrderItem[]
  activities         OrderActivity[]
  payments           OrderPayment[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, customerPhone])
  @@index([organizationId, createdAt])
  @@index([organizationId, deletedAt])
  @@index([organizationId, courierStatusSlug])
  @@index([organizationId, courierProvider, courierConsignmentId])
  @@index([courierProvider, courierStatusSyncedAt])
}

/// Website / sync intake that failed (duplicate, blocked, invalid) — org-scoped queue.
model FailedOrder {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerName     String
  customerPhone    String
  address          String
  /// Product name previews for list UI
  products         String[]     @default([])
  /// pending | recovered | dismissed
  queueStatus      String       @default("pending")
  /// duplicate | blocked | other
  failedType       String
  website          String?
  lastUpdateNote   String?
  /// Full CreateOrderPayload JSON for retry → create
  payload          Json
  recoveredOrderId String?
  recoveredAt      DateTime?
  dismissedAt      DateTime?
  createdByUserId  String?
  createdByName    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, queueStatus, createdAt])
  @@index([organizationId, failedType])
  @@index([organizationId, website])
  @@index([organizationId, createdAt])
}

/// COD / advance collection ledger — one tracking row per order (org-scoped).
model OrderPayment {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// cod | bkash | nagad | bank | cash
  method           String       @default("cod")
  /// pending | collected | reconciled
  status           String       @default("pending")
  collectedAmount  Float        @default(0)
  note             String?
  collectedAt      DateTime?
  reconciledAt     DateTime?
  createdByUserId  String?
  createdByName    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, orderId])
  @@index([organizationId, status])
  @@index([organizationId, method])
  @@index([organizationId, createdAt])
}

model Followup {
  id                String    @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queue             Int       @default(1)
  orderId           String?
  orderNumber       String?
  customerId        String
  customerNumber    String
  scheduleDate      DateTime? @db.Date
  skipped           Boolean   @default(false)
  name              String
  phone             String
  address           String?
  area              String?
  district          String?
  followupNotes     String?
  customerNotes     String?
  followupStatus    String    @default("no_status")
  type              String    @default("listed")
  recentProducts    Json      @default("[]")
  tags              String[]  @default([])
  smsStatus         String    @default("not_sent")
  assignedAgentName String?
  source            String
  activities        Json      @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([organizationId, orderId])
  @@index([organizationId, queue])
  @@index([organizationId, phone])
  @@index([organizationId, scheduleDate])
  @@index([organizationId, followupStatus])
}

model Coupon {
  id              String    @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code            String
  type            String // percent | fixed
  value           Float
  minOrderBdt     Float?
  maxDiscountBdt  Float?
  usageCount      Int       @default(0)
  usageLimit      Int?
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organizationId  String
  productId       String?
  variantId       String?
  productName     String
  variationLabel  String?
  sku             String?
  quantity        Int
  returnedQuantity Int     @default(0)
  unitPrice       Float
  discount        Float    @default(0)
  lineTotal       Float
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([organizationId])
}

model OrderActivity {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organizationId String
  type           String
  label          String
  description    String?
  actorUserId    String?
  actorName      String?
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([organizationId])
}

/// Org-configurable create-order dropdowns / defaults (not hardcoded in UI).
model OrderFormOption {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String // status | payment_method | source | district | order_tag | customer_tag | default_courier_note | default_shipping
  value          String
  label          String
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, kind, value])
  @@index([organizationId, kind, isActive])
}

/// Org-scoped order status definitions (nav, tabs, workflow) — source of truth for CRM statuses.
model OrgOrderStatus {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug                String
  label               String
  labelBn             String?
  color               String       @default("hsl(174 58% 42%)")
  /// intake | confirm | fulfillment | delivery | returns | terminal | special
  group               String       @default("intake")
  /// Queue folder (pendings, followups) or another status slug
  parentSlug          String?
  /// sidebar | nested_tab | filter_only | sidebar_and_tab
  displayMode         String       @default("filter_only")
  showInSidebar       Boolean?
  showInNestedTabs    Boolean?
  sidebarOrder        Int?
  isTerminal          Boolean      @default(false)
  isDefault           Boolean      @default(false)
  isSystem            Boolean      @default(false)
  isActive            Boolean      @default(true)
  allowedTransitions  String[]     @default([])
  bulkActions         String[]     @default([])
  showInGroupByStatus Boolean      @default(true)
  sortOrder           Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@index([organizationId, parentSlug])
}

/// Org-configurable Orders sidebar queue folders (Call confirm, Follow-ups, custom…).
model OrgOrderQueue {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug             String
  label            String
  description      String       @default("")
  /// list | form | failed | tool | payments
  kind             String       @default("list")
  href             String
  sidebarOrder     Int          @default(10)
  showInNav        Boolean      @default(true)
  defaultChildSlug String?
  /// When true, list applies follow-up-due age filter
  followUpDue      Boolean      @default(false)
  isSystem         Boolean      @default(false)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@index([organizationId, showInNav])
}

/// Product manufacturer / label brand (not tenant CRM theming).
model ProductBrand {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, deletedAt])
}

model OrgCategory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String // product | income | expense | knowledge
  slug           String
  label          String
  description    String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  isSystem       Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]

  @@unique([organizationId, kind, slug])
  @@index([organizationId, kind])
  @@index([organizationId, kind, isActive])
  @@index([organizationId, kind, deletedAt])
}

model Product {
  id             String                   @id @default(uuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandId        String?
  brand          ProductBrand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       OrgCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  sku            String
  description    String?
  imageUrl       String?
  imageKey       String?
  status         String                   @default("active") // active | inactive | discontinued
  reorderLevel   Int                      @default(5)
  supplierName   String?
  notes          String?
  tags           String[]                 @default([])
  deletedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  variants       ProductVariant[]
  stockMovements   InventoryStockMovement[]
  activities       CatalogActivity[]
  purchaseLines    InventoryPurchaseLine[]
  returnLines      InventoryPurchaseReturnLine[]
  mixerRecipes     MixerRecipe[]
  productionBatches ProductionBatch[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([brandId])
  @@index([categoryId])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
}

model ProductVariant {
  id             String                   @id @default(uuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label          String
  sku            String
  barcode        String?
  baseUomId      String?
  baseUom        UnitOfMeasure?           @relation(fields: [baseUomId], references: [id], onDelete: SetNull)
  salePrice      Decimal                  @db.Decimal(12, 2)
  costPrice      Decimal?                 @db.Decimal(12, 2)
  stock          Int                      @default(0)
  reorderLevel   Int                      @default(5)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  stockMovements InventoryStockMovement[]
  purchaseLines  InventoryPurchaseLine[]
  returnLines    InventoryPurchaseReturnLine[]
  stockLevels    InventoryStockLevel[]
  lots           InventoryLot[]
  uomConversions VariantUomConversion[]

  @@unique([organizationId, sku])
  @@unique([productId, sku])
  @@unique([organizationId, barcode])
  @@index([productId])
  @@index([organizationId])
  @@index([baseUomId])
}

/// Tenant-scoped units of measure (pcs, kg, L, box, etc.).
model UnitOfMeasure {
  id                   String                 @id @default(uuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  /// count | mass | volume | length | area | other
  dimension            String                 @default("count")
  /// Multiply qty in this unit by factor to get dimension base (g=1, kg=1000, ml=1, L=1000, pcs=1).
  factorToDimensionBase Decimal               @default(1) @db.Decimal(18, 6)
  isSystem             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  variants             ProductVariant[]
  variantConversions   VariantUomConversion[]

  @@unique([organizationId, code])
  @@index([organizationId, dimension])
}

/// Alternate purchase/sell units for a variant (e.g. 1 box = 12 pcs).
model VariantUomConversion {
  id              String         @id @default(uuid())
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  uomId           String
  uom             UnitOfMeasure  @relation(fields: [uomId], references: [id], onDelete: Cascade)
  /// qtyInUom * factorToVariantBase = qty in variant base UoM
  factorToVariantBase Decimal    @db.Decimal(18, 6)

  @@unique([variantId, uomId])
  @@index([uomId])
}

/// Immutable stock ledger for catalog variants.
model InventoryStockMovement {
  id              String          @id @default(uuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId     String?
  warehouse       Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lotId           String?
  lot             InventoryLot?   @relation(fields: [lotId], references: [id], onDelete: SetNull)
  delta           Int
  previousStock   Int
  newStock        Int
  unitCost        Decimal?        @db.Decimal(12, 2)
  valueDelta      Decimal?        @db.Decimal(14, 2)
  reason          String
  note            String?
  sourceType      String?
  sourceId        String?
  transferGroupId String?
  actorUserId     String?
  actorName       String?
  createdAt       DateTime        @default(now())

  @@index([organizationId, createdAt])
  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([organizationId, reason, createdAt])
  @@index([organizationId, warehouseId, createdAt])
  @@index([organizationId, sourceType, sourceId])
}

model Warehouse {
  id             String                  @id @default(uuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  address        String?
  isDefault      Boolean                 @default(false)
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  stockLevels    InventoryStockLevel[]
  lots           InventoryLot[]
  stockMovements InventoryStockMovement[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model InventoryStockLevel {
  id             String         @id @default(uuid())
  organizationId String
  warehouseId    String
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity       Int            @default(0)
  updatedAt      DateTime       @updatedAt

  @@unique([warehouseId, variantId])
  @@index([organizationId, variantId])
}

model InventoryLot {
  id              String                   @id @default(uuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouseId     String?
  warehouse       Warehouse?               @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lotNumber       String
  barcode         String?
  manufacturedAt  DateTime?
  expiresAt       DateTime?
  receivedAt      DateTime                 @default(now())
  quantity        Int                      @default(0)
  unitCost        Decimal?                 @db.Decimal(12, 2)
  status          String                   @default("active")
  createdAt       DateTime                 @default(now())
  stockMovements  InventoryStockMovement[]

  @@unique([organizationId, variantId, lotNumber])
  @@index([organizationId, expiresAt])
  @@index([variantId, expiresAt])
  @@index([warehouseId])
}

model AccountingJournalEntry {
  id             String                  @id @default(uuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryDate      DateTime                @default(now())
  description    String
  reference      String?
  sourceType     String
  sourceId       String
  eventKey       String
  status         String                  @default("posted")
  postedAt       DateTime                @default(now())
  lines          AccountingJournalLine[]

  @@unique([organizationId, eventKey])
  @@index([organizationId, entryDate])
  @@index([organizationId, sourceType, sourceId])
}

model AccountingJournalLine {
  id             String                 @id @default(uuid())
  journalEntryId String
  journalEntry   AccountingJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountCode    String
  accountName    String
  debit          Decimal                @default(0) @db.Decimal(14, 2)
  credit         Decimal                @default(0) @db.Decimal(14, 2)

  @@index([journalEntryId])
  @@index([accountCode])
}

model InventorySupplier {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  status         String              @default("active")
  tags           String[]            @default([])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  purchases      InventoryPurchase[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model InventoryPurchase {
  id             String                  @id @default(uuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       InventorySupplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseNumber String
  paymentStatus  String                  @default("unpaid")
  stockStatus    String                  @default("pending")
  purchaseDate   DateTime                @default(now())
  dueDate        DateTime?
  notes          String?
  receivedAt     DateTime?
  receivedById   String?
  receivedByName String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  lines          InventoryPurchaseLine[]
  returns        InventoryPurchaseReturn[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId, purchaseDate])
  @@index([organizationId, stockStatus])
  @@index([supplierId])
}

model InventoryPurchaseLine {
  id         String             @id @default(uuid())
  purchaseId String
  purchase   InventoryPurchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  String
  variant    ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  unitCost   Decimal            @db.Decimal(12, 2)
  createdAt  DateTime           @default(now())

  @@index([purchaseId])
  @@index([productId])
  @@index([variantId])
}

model InventoryPurchaseReturn {
  id             String                       @id @default(uuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseId     String?
  purchase       InventoryPurchase?           @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  returnNumber   String
  purchaseNumber String
  supplierName   String
  status         String                       @default("pending") // pending | approved | completed
  returnDate     DateTime                     @default(now())
  reason         String?
  completedAt    DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  lines          InventoryPurchaseReturnLine[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId, returnDate])
  @@index([organizationId, status])
  @@index([purchaseId])
}

model InventoryPurchaseReturnLine {
  id         String                  @id @default(uuid())
  returnId   String
  return     InventoryPurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId  String
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  String
  variant    ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  unitCost   Decimal                 @db.Decimal(12, 2)
  createdAt  DateTime                @default(now())

  @@index([returnId])
  @@index([productId])
  @@index([variantId])
}

model MixerRecipe {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  outputProductId  String
  outputProduct    Product      @relation(fields: [outputProductId], references: [id], onDelete: Restrict)
  outputQty        Int          @default(1)
  status           String       @default("active") // active | draft
  inputs           Json
  lastMixedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([outputProductId])
}

model ProductionBatch {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchNumber     String
  outputProductId String
  outputProduct   Product      @relation(fields: [outputProductId], references: [id], onDelete: Restrict)
  result          Json
  actorUserId     String?
  actorName       String?
  createdAt       DateTime     @default(now())

  @@unique([organizationId, batchNumber])
  @@index([organizationId, createdAt])
  @@index([outputProductId])
}

model CatalogActivity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String // brand | category | product | variant
  entityId       String
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  action         String
  label          String
  description    String?
  actorUserId    String?
  actorName      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([productId, createdAt])
}
