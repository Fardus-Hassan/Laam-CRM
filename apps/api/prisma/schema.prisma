generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  plan               String
  status             String             @default("active") // active | suspended | onboarding
  phone              String?
  // Tenant brand colors + light/dark logo URLs
  branding           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  users              User[]
  teams              Team[]
  customRoles        CustomRole[]
  permissionPresets  PermissionPreset[]
  notifications      Notification[]
  productBrands      ProductBrand[]
  orgCategories      OrgCategory[]
  products           Product[]
  productVariants    ProductVariant[]
  stockMovements     InventoryStockMovement[]
  catalogActivities  CatalogActivity[]
  inventorySuppliers       InventorySupplier[]
  inventoryPurchases       InventoryPurchase[]
  inventoryPurchaseReturns InventoryPurchaseReturn[]
  mixerRecipes             MixerRecipe[]
  productionBatches        ProductionBatch[]
  warehouses               Warehouse[]
  inventoryLots            InventoryLot[]
  accountingJournalEntries AccountingJournalEntry[]
  unitsOfMeasure           UnitOfMeasure[]
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  inviteTempPassword  String?
  name                String
  systemRole          String
  status              String         @default("active") // active | invited | suspended
  organizationId      String?
  organization        Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRoleId        String?
  customRole          CustomRole?    @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  permissionGrants    String[]       @default([])
  permissionDenies    String[]       @default([])
  teamId              String?
  team                Team?          @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeams            Team[]         @relation("TeamLeader")
  invitedByUserId     String?
  invitedBy           User?          @relation("UserInvites", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitedUsers        User[]         @relation("UserInvites")
  lastSeenAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  otpChallenges       OtpChallenge[]
  trustedDevices      TrustedDevice[]
  notifications       Notification[]

  @@index([organizationId])
  @@index([teamId])
  @@index([customRoleId])
  @@index([invitedByUserId])
}

model CustomRole {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  permissions       String[]     @default([])
  dashboardTemplate String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  users             User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PermissionPreset {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  permissions       String[]     @default([])
  dashboardTemplate String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  leaderUserId   String
  leader         User         @relation("TeamLeader", fields: [leaderUserId], references: [id], onDelete: Restrict)
  members        User[]       @relation("TeamMembers")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([leaderUserId])
}

model OtpChallenge {
  id             String    @id @default(uuid())
  purpose        String
  email          String
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  codeHash       String
  relayCode      String?
  expiresAt      DateTime
  resendAfter    DateTime
  attempts       Int       @default(0)
  consumedAt     DateTime?
  delivery       String    // email | admin_inbox
  createdAt      DateTime  @default(now())

  @@index([email, purpose])
  @@index([organizationId, delivery])
}

model TrustedDevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  label     String?
  trustedAt DateTime @default(now())

  @@unique([userId, deviceId])
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  title          String
  body           String
  href           String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

model Lead {
  id                String   @id @default(cuid())
  organizationId    String?
  leadNumber        String   @unique
  name              String
  phone             String
  email             String?
  source            String
  status            String
  assignedAgentName String?
  area              String?
  estimatedValue    Float?
  campaignName      String?
  notes             String?
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Contact {
  id                String   @id @default(cuid())
  organizationId    String?
  name              String
  phone             String
  email             String?
  companyName       String?
  jobTitle          String?
  source            String
  assignedAgentName String?
  address           String?
  notes             String?
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Company {
  id                String   @id @default(cuid())
  organizationId    String?
  name              String
  industry          String?
  status            String
  phone             String?
  email             String?
  contactCount      Int      @default(0)
  dealValue         Float    @default(0)
  assignedAgentName String?
  city              String?
  address           String?
  website           String?
  notes             String?
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Deal {
  id                String    @id @default(cuid())
  organizationId    String?
  dealNumber        String    @unique
  title             String
  companyName       String
  contactName       String?
  stage             String
  amount            Float
  probability       Int
  expectedCloseDate DateTime?
  assignedAgentName String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Order {
  id                String   @id @default(cuid())
  organizationId    String?
  orderNumber       String   @unique
  status            String
  customerName      String
  customerPhone     String
  source            String
  itemsCount        Int
  amount            Float
  paymentStatus     String
  assignedAgentName String?
  shippingArea      String
  shippingAddress   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Product manufacturer / label brand (not tenant CRM theming).
model ProductBrand {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, deletedAt])
}

model OrgCategory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String // product | income | expense | knowledge
  slug           String
  label          String
  description    String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  isSystem       Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]

  @@unique([organizationId, kind, slug])
  @@index([organizationId, kind])
  @@index([organizationId, kind, isActive])
  @@index([organizationId, kind, deletedAt])
}

model Product {
  id             String                   @id @default(uuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandId        String?
  brand          ProductBrand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       OrgCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  sku            String
  description    String?
  imageUrl       String?
  imageKey       String?
  status         String                   @default("active") // active | inactive | discontinued
  reorderLevel   Int                      @default(5)
  supplierName   String?
  notes          String?
  tags           String[]                 @default([])
  deletedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  variants       ProductVariant[]
  stockMovements   InventoryStockMovement[]
  activities       CatalogActivity[]
  purchaseLines    InventoryPurchaseLine[]
  returnLines      InventoryPurchaseReturnLine[]
  mixerRecipes     MixerRecipe[]
  productionBatches ProductionBatch[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([brandId])
  @@index([categoryId])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
}

model ProductVariant {
  id             String                   @id @default(uuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label          String
  sku            String
  barcode        String?
  baseUomId      String?
  baseUom        UnitOfMeasure?           @relation(fields: [baseUomId], references: [id], onDelete: SetNull)
  salePrice      Decimal                  @db.Decimal(12, 2)
  costPrice      Decimal?                 @db.Decimal(12, 2)
  stock          Int                      @default(0)
  reorderLevel   Int                      @default(5)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  stockMovements InventoryStockMovement[]
  purchaseLines  InventoryPurchaseLine[]
  returnLines    InventoryPurchaseReturnLine[]
  stockLevels    InventoryStockLevel[]
  lots           InventoryLot[]
  uomConversions VariantUomConversion[]

  @@unique([organizationId, sku])
  @@unique([productId, sku])
  @@unique([organizationId, barcode])
  @@index([productId])
  @@index([organizationId])
  @@index([baseUomId])
}

/// Tenant-scoped units of measure (pcs, kg, L, box, etc.).
model UnitOfMeasure {
  id                   String                 @id @default(uuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  /// count | mass | volume | length | area | other
  dimension            String                 @default("count")
  /// Multiply qty in this unit by factor to get dimension base (g=1, kg=1000, ml=1, L=1000, pcs=1).
  factorToDimensionBase Decimal               @default(1) @db.Decimal(18, 6)
  isSystem             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  variants             ProductVariant[]
  variantConversions   VariantUomConversion[]

  @@unique([organizationId, code])
  @@index([organizationId, dimension])
}

/// Alternate purchase/sell units for a variant (e.g. 1 box = 12 pcs).
model VariantUomConversion {
  id              String         @id @default(uuid())
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  uomId           String
  uom             UnitOfMeasure  @relation(fields: [uomId], references: [id], onDelete: Cascade)
  /// qtyInUom * factorToVariantBase = qty in variant base UoM
  factorToVariantBase Decimal    @db.Decimal(18, 6)

  @@unique([variantId, uomId])
  @@index([uomId])
}

/// Immutable stock ledger for catalog variants.
model InventoryStockMovement {
  id              String          @id @default(uuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId     String?
  warehouse       Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lotId           String?
  lot             InventoryLot?   @relation(fields: [lotId], references: [id], onDelete: SetNull)
  delta           Int
  previousStock   Int
  newStock        Int
  unitCost        Decimal?        @db.Decimal(12, 2)
  valueDelta      Decimal?        @db.Decimal(14, 2)
  reason          String
  note            String?
  sourceType      String?
  sourceId        String?
  transferGroupId String?
  actorUserId     String?
  actorName       String?
  createdAt       DateTime        @default(now())

  @@index([organizationId, createdAt])
  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([organizationId, reason, createdAt])
  @@index([organizationId, warehouseId, createdAt])
  @@index([organizationId, sourceType, sourceId])
}

model Warehouse {
  id             String                  @id @default(uuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  address        String?
  isDefault      Boolean                 @default(false)
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  stockLevels    InventoryStockLevel[]
  lots           InventoryLot[]
  stockMovements InventoryStockMovement[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model InventoryStockLevel {
  id             String         @id @default(uuid())
  organizationId String
  warehouseId    String
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity       Int            @default(0)
  updatedAt      DateTime       @updatedAt

  @@unique([warehouseId, variantId])
  @@index([organizationId, variantId])
}

model InventoryLot {
  id              String                   @id @default(uuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouseId     String?
  warehouse       Warehouse?               @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lotNumber       String
  barcode         String?
  manufacturedAt  DateTime?
  expiresAt       DateTime?
  receivedAt      DateTime                 @default(now())
  quantity        Int                      @default(0)
  unitCost        Decimal?                 @db.Decimal(12, 2)
  status          String                   @default("active")
  createdAt       DateTime                 @default(now())
  stockMovements  InventoryStockMovement[]

  @@unique([organizationId, variantId, lotNumber])
  @@index([organizationId, expiresAt])
  @@index([variantId, expiresAt])
  @@index([warehouseId])
}

model AccountingJournalEntry {
  id             String                  @id @default(uuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryDate      DateTime                @default(now())
  description    String
  reference      String?
  sourceType     String
  sourceId       String
  eventKey       String
  status         String                  @default("posted")
  postedAt       DateTime                @default(now())
  lines          AccountingJournalLine[]

  @@unique([organizationId, eventKey])
  @@index([organizationId, entryDate])
  @@index([organizationId, sourceType, sourceId])
}

model AccountingJournalLine {
  id             String                 @id @default(uuid())
  journalEntryId String
  journalEntry   AccountingJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountCode    String
  accountName    String
  debit          Decimal                @default(0) @db.Decimal(14, 2)
  credit         Decimal                @default(0) @db.Decimal(14, 2)

  @@index([journalEntryId])
  @@index([accountCode])
}

model InventorySupplier {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  status         String              @default("active")
  tags           String[]            @default([])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  purchases      InventoryPurchase[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model InventoryPurchase {
  id             String                  @id @default(uuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       InventorySupplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseNumber String
  paymentStatus  String                  @default("unpaid")
  stockStatus    String                  @default("pending")
  purchaseDate   DateTime                @default(now())
  dueDate        DateTime?
  notes          String?
  receivedAt     DateTime?
  receivedById   String?
  receivedByName String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  lines          InventoryPurchaseLine[]
  returns        InventoryPurchaseReturn[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId, purchaseDate])
  @@index([organizationId, stockStatus])
  @@index([supplierId])
}

model InventoryPurchaseLine {
  id         String             @id @default(uuid())
  purchaseId String
  purchase   InventoryPurchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  String
  variant    ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  unitCost   Decimal            @db.Decimal(12, 2)
  createdAt  DateTime           @default(now())

  @@index([purchaseId])
  @@index([productId])
  @@index([variantId])
}

model InventoryPurchaseReturn {
  id             String                       @id @default(uuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseId     String?
  purchase       InventoryPurchase?           @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  returnNumber   String
  purchaseNumber String
  supplierName   String
  status         String                       @default("pending") // pending | approved | completed
  returnDate     DateTime                     @default(now())
  reason         String?
  completedAt    DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  lines          InventoryPurchaseReturnLine[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId, returnDate])
  @@index([organizationId, status])
  @@index([purchaseId])
}

model InventoryPurchaseReturnLine {
  id         String                  @id @default(uuid())
  returnId   String
  return     InventoryPurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId  String
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  String
  variant    ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  unitCost   Decimal                 @db.Decimal(12, 2)
  createdAt  DateTime                @default(now())

  @@index([returnId])
  @@index([productId])
  @@index([variantId])
}

model MixerRecipe {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  outputProductId  String
  outputProduct    Product      @relation(fields: [outputProductId], references: [id], onDelete: Restrict)
  outputQty        Int          @default(1)
  status           String       @default("active") // active | draft
  inputs           Json
  lastMixedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([outputProductId])
}

model ProductionBatch {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchNumber     String
  outputProductId String
  outputProduct   Product      @relation(fields: [outputProductId], references: [id], onDelete: Restrict)
  result          Json
  actorUserId     String?
  actorName       String?
  createdAt       DateTime     @default(now())

  @@unique([organizationId, batchNumber])
  @@index([organizationId, createdAt])
  @@index([outputProductId])
}

model CatalogActivity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String // brand | category | product | variant
  entityId       String
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  action         String
  label          String
  description    String?
  actorUserId    String?
  actorName      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([productId, createdAt])
}
